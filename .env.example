# Databricks connection (Azure China) -- IBPI safety incremental (HPPP)
# Copy this file to ".env" and fill in the real values. ".env" is git-ignored.
# Never commit real tokens.

DATABRICKS_HOST=adb-xxxxxxxxxxxxxxxx.x.databricks.azure.cn
DATABRICKS_HTTP_PATH=sql/protocolv1/o/xxxxxxxxxxxxxxxx/xxxx-xxxxxx-xxxxxxxx
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional tuning (defaults shown)
# IBPI_WEEKS_AHEAD=26            # how many future weekly Mondays to pull (~half year)
# IBPI_CATEGORY=Hair Care        # category filter
# IBPI_BATCH_SIZE=5              # max keyfiguredate values per query batch
# DATABRICKS_CONNECT_TIMEOUT=30 # socket timeout (seconds) for connect
# DATABRICKS_QUERY_TIMEOUT=300  # overall query timeout (seconds) before abandoning (raise on slow networks)
# DATABRICKS_BYPASS_PROXY=1     # 1 = bypass corporate proxy (needed on Azure China IP allow-list)
